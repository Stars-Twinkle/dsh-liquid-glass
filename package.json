{
  "name": "@stars-twinkle/dsh-liquid-glass",
  "version": "1.0.0",
  "private": true,
  "description": "Liquid-glass skin for the DeepSeek Harness web UI: window wallpaper, frosted sidebar and conversation panel, glass composer, cards and modals.",
  "type": "module",
  "license": "MIT",
  "author": "Stars-Twinkle",
  "homepage": "https://github.com/Stars-Twinkle/dsh-liquid-glass",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stars-Twinkle/dsh-liquid-glass.git"
  },
  "bugs": {
    "url": "https://github.com/Stars-Twinkle/dsh-liquid-glass/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "theme",
    "skin",
    "liquid-glass",
    "glassmorphism"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
